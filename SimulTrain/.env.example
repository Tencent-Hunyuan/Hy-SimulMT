# ============================================================
# 复制成 .env 再改：cp .env.example .env
# ============================================================
# .env 只放跟机器相关的路径与资源配置，已被 .gitignore 排除，不会提交。
# 训练/推理脚本启动时自动读取它。
#
# 规则：
#   - 一行一个 KEY=value，不要加空格，不要写引号也可以
#   - 命令行里已经给过的同名变量优先，不会被这里覆盖
#     例：GPU=0,1 bash train_merged.sh会用 0,1 而不是下面配的值

# ---------- 合并模型（必填，只读）----------
MERGED_MODEL_PATH=/path/to/Hy-SimulMT-30B-A3B-Interleave

# ---------- 数据（必填）----------
# DATASET_DIR：含 dataset_info.json 的目录
# MEDIA_DIR：音频根目录，数据里的相对路径基于它；留空则等于 DATASET_DIR
#
# 数据格式模板见data_demo/；先替换示例音频路径和对应文本。
#   DATASET_DIR=./data_demo
DATASET_DIR=/path/to/your/train_data
MEDIA_DIR=

# dataset_info.json 里注册的数据集名
DATASET=merged_st_demo

# ---------- 输出（必填）----------
# 必须与模型目录不同。LLM 视图、日志、checkpoint 都写在这里。
OUTPUT_DIR=/path/to/output/merged_a3b_run

# ---------- GPU ----------
# 单卡写 0；多卡逗号隔开 0,1,2,3（几张卡就起几个 DDP 进程）
GPU=0

# ---------- 训练规模（可选，留空用脚本默认值）----------
# MAX_STEPS 优先；填了就按步数训，留空则按 EPOCHS 轮数训
MAX_STEPS=
EPOCHS=1.0

# BATCH_SIZE 是单卡批量；等效批量 = BATCH_SIZE × GRAD_ACCUM × 总进程数
BATCH_SIZE=1
GRAD_ACCUM=2

# 学习率。只训 Adapter 时 5e-5 合适；全参微调 LLM 建议降到 1e-5 附近
LR=1.0e-5

# ---------- 验证与早停 ----------
#每多少 epoch 验证一次，脚本自动换算成 eval_steps（换数据集/改批量都不用重算）
# 验证不免费：0.2 会让 eval 占掉近三成训练时间，建议 0.5 ~ 1
EVAL_EVERY_EPOCH=0.5
# 想固定 step 数就填这个，会覆盖上面的自动换算
EVAL_STEPS=

# 连续多少【次评估】没有改善就停（留空=关闭）。实际步数 = EARLY_STOP × eval_steps
# 用法：设一个较大的 EPOCHS 上限，让它自己停
EARLY_STOP=
# 改善幅度小于它就算「没变化」
EARLY_STOP_THRESHOLD=0.001

# ---------- 可选 ----------
# 指定 Python 解释器（不用仓库里的 .venv 时才需要）
# S2S_PYTHON=/path/to/python

# GPU 被别人占用时也强行启动
# ALLOW_BUSY_GPU=1

# 分布式端口，同机跑多个任务时要错开
# MASTER_PORT=29500
